{
  "api_version": "1.2.0",
  "provider_id": "fbx_exporter",
  "schema_version": 1,
  "tools": [
    {
      "description": "Read the connected project, FBX export availability, map choices and default output folder. No files are written.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "fbx_exporter_status",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Find Static Mesh assets by name in this project or a mounted content root, without loading them. Returns exact object paths. Narrow query/root if truncated; retry if asset_registry_loading is true.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 40,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          },
          "root": {
            "default": "/Game",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "fbx_exporter_find_meshes",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Check mesh LOD0/UV0, renderer and output paths without writing files or opening dialogs. Reports requires_overwrite; replacement includes user files inside the mesh folder. Filesystem permissions and actual bake success are checked during export.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "embed_textures": {
            "default": false,
            "description": "Include PNG bytes inside FBX. External PNGs and material JSON are still produced when maps are selected.",
            "type": "boolean"
          },
          "maps": {
            "description": "Omit for all six maps; [] exports geometry only.",
            "items": {
              "enum": [
                "BaseColor",
                "Normal",
                "Mask",
                "Occlusion",
                "Emission",
                "Opacity"
              ],
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "mesh_path": {
            "description": "Exact Static Mesh object path from fbx_exporter_find_meshes.",
            "type": "string"
          },
          "mesh_paths": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "output_layout": {
            "default": "mesh_name",
            "enum": [
              "mesh_name",
              "asset_path"
            ],
            "type": "string"
          },
          "output_root": {
            "description": "Absolute output root. Default: the current project's Saved/FBX_Exporter/Exports. A mesh-named subfolder is created.",
            "type": "string"
          },
          "resolution": {
            "default": 2048,
            "enum": [
              512,
              1024,
              2048,
              4096
            ],
            "type": "integer"
          },
          "reuse_direct_textures": {
            "default": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "fbx_exporter_preflight",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Export one Static Mesh using FBX_Exporter, with selected PNGs and optional embedded PNG bytes. Requires PIE stopped and a rendering Editor for textures. Run preflight first; existing output is refused unless overwrite=true. Runs to completion on the Editor game thread; allow a long timeout for baking. Returns saved files, warnings and errors. JSON is metadata; FBX stores texture connections.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "embed_textures": {
            "default": false,
            "description": "Include PNG bytes inside FBX. External PNGs and material JSON are still produced when maps are selected.",
            "type": "boolean"
          },
          "maps": {
            "description": "Omit for all six maps; [] exports geometry only.",
            "items": {
              "enum": [
                "BaseColor",
                "Normal",
                "Mask",
                "Occlusion",
                "Emission",
                "Opacity"
              ],
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "mesh_path": {
            "description": "Exact Static Mesh object path from fbx_exporter_find_meshes.",
            "type": "string"
          },
          "output_layout": {
            "default": "mesh_name",
            "enum": [
              "mesh_name",
              "asset_path"
            ],
            "type": "string"
          },
          "output_root": {
            "description": "Absolute output root. Default: the current project's Saved/FBX_Exporter/Exports. A mesh-named subfolder is created.",
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "description": "Explicitly replace the entire existing mesh output folder, including user files. Inspect preflight first.",
            "type": "boolean"
          },
          "resolution": {
            "default": 2048,
            "enum": [
              512,
              1024,
              2048,
              4096
            ],
            "type": "integer"
          },
          "reuse_direct_textures": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "mesh_path"
        ],
        "type": "object"
      },
      "name": "fbx_exporter_export",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "List/get/save/delete project FBX profiles. Builtin pbr and geometry_only are immutable. Profiles never store overwrite approval.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "list",
              "get",
              "save",
              "delete"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          },
          "profile": {
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "fbx_exporter_profiles",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Persist and queue ordered exports. Returns a job_id before asset loading. Same request_id+request returns the existing job; changed request errors. First failed target stops later targets.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "mesh_paths": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "options": {
            "additionalProperties": false,
            "properties": {
              "embed_textures": {
                "default": false,
                "description": "Include PNG bytes inside FBX. External PNGs and material JSON are still produced when maps are selected.",
                "type": "boolean"
              },
              "maps": {
                "description": "Omit for all six maps; [] exports geometry only.",
                "items": {
                  "enum": [
                    "BaseColor",
                    "Normal",
                    "Mask",
                    "Occlusion",
                    "Emission",
                    "Opacity"
                  ],
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "output_layout": {
                "default": "mesh_name",
                "enum": [
                  "mesh_name",
                  "asset_path"
                ],
                "type": "string"
              },
              "output_root": {
                "description": "Absolute output root. Default: the current project's Saved/FBX_Exporter/Exports. A mesh-named subfolder is created.",
                "type": "string"
              },
              "resolution": {
                "default": 2048,
                "enum": [
                  512,
                  1024,
                  2048,
                  4096
                ],
                "type": "integer"
              },
              "reuse_direct_textures": {
                "default": true,
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "overrides": {
            "additionalProperties": {
              "type": "object"
            },
            "type": "object"
          },
          "overwrite": {
            "default": false,
            "type": "boolean"
          },
          "profile_id": {
            "type": "string"
          },
          "request_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "mesh_paths"
        ],
        "type": "object"
      },
      "name": "fbx_exporter_job_start",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Query by job_id or request_id. success describes the lookup, state describes the actual job. Native GPU/FBX calls can delay replies.",
      "inputSchema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "job_id"
            ]
          },
          {
            "required": [
              "request_id"
            ]
          }
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "fbx_exporter_job_status",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    {
      "description": "Request safe-boundary cancellation or acknowledge inspected recovery without deleting/restoring files. Only the job's own recorded recovery journals can be acknowledged.",
      "inputSchema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "job_id"
            ]
          },
          {
            "required": [
              "request_id"
            ]
          }
        ],
        "properties": {
          "action": {
            "enum": [
              "cancel",
              "acknowledge_recovery"
            ],
            "type": "string"
          },
          "job_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      "name": "fbx_exporter_job_control",
      "outputSchema": {
        "additionalProperties": true,
        "oneOf": [
          {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "string"
              },
              "error_code": {
                "type": "string"
              },
              "success": {
                "const": false
              }
            },
            "required": [
              "error"
            ]
          }
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    }
  ]
}
